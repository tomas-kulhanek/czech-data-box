{
  "name": "tomas-kulhanek/czech-data-box",
  "description": "Modern PHP client for Czech Data Boxes (ISDS): send and receive data messages, large-volume messages (VoDZ), current WSDL 3.11 API",
  "license": "MIT",
  "homepage": "https://github.com/tomas-kulhanek/czech-data-box",
  "authors": [
    {
      "name": "Tomáš Kulhánek",
      "email": "jsem@tomaskulhanek.cz",
      "homepage": "https://github.com/tomas-kulhanek"
    }
  ],
  "keywords": [
    "isds",
    "datove-schranky",
    "datova-schranka",
    "datovky",
    "data-box",
    "czech-data-box",
    "egovernment",
    "dia",
    "soap",
    "vodz",
    "czech"
  ],
  "type": "library",
  "support": {
    "email": "jsem@tomaskulhanek.cz",
    "issues": "https://github.com/tomas-kulhanek/czech-data-box/issues",
    "source": "https://github.com/tomas-kulhanek/czech-data-box",
    "docs": "https://github.com/tomas-kulhanek/czech-data-box#readme"
  },
  "require": {
    "php": "^8.4",
    "ext-curl": "*",
    "ext-dom": "*",
    "ext-mbstring": "*",
    "ext-openssl": "*",
    "ext-xml": "*",
    "composer/ca-bundle": "^1.5",
    "jms/serializer": "^3.32"
  },
  "autoload": {
    "psr-4": {
      "TomasKulhanek\\CzechDataBox\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "TomasKulhanek\\Tests\\CzechDataBox\\": "tests/",
      "TomasKulhanek\\CzechDataBox\\Tools\\": "tools/"
    }
  },
  "suggest": {
    "ext-curl": "for comunication with czech databox servers",
    "guzzlehttp/guzzle": "for usage with guzzle",
    "symfony/http-client": "for usage with symfony",
    "symfony/validator": "to validate request DTOs yourself against the #[Assert\\*] constraints shipped with them"
  },
  "require-dev": {
    "guzzlehttp/guzzle": "^8.0",
    "nyholm/psr7": "^1.8",
    "php-http/httplug": "^2.4",
    "symfony/http-client": "7.*|8.*",
    "symfony/validator": "^7.0 || ^8.0",
    "phpstan/phpstan": "^2.2",
    "phpunit/phpunit": "^13.3",
    "rector/rector": "^2.6",
    "squizlabs/php_codesniffer": "^4.0"
  },
  "scripts": {
    "check": [
      "@check:phpstan",
      "@check:cs",
      "@check:rector",
      "@check:wsdl-coverage",
      "@check:links",
      "@test:unit"
    ],
    "test:phpunit": "php -d xdebug.mode=off vendor/phpunit/phpunit/phpunit",
    "test:unit": "php -d xdebug.mode=off vendor/phpunit/phpunit/phpunit --testsuite unit",
    "test:integration": "php -d xdebug.mode=off vendor/phpunit/phpunit/phpunit --testsuite integration",
    "check:phpstan": "php -d memory_limit=512M vendor/bin/phpstan analyse -c phpstan.neon",
    "check:rector": "php vendor/bin/rector process src tests tools --dry-run",
    "check:cs": "phpcs --extensions=php --standard=PSR12 -n src tests tools",
    "check:wsdl-coverage": "php tools/wsdl-coverage.php --check",
    "check:links": "php tools/markdown-links.php --local",
    "check:links-external": "php tools/markdown-links.php --external",
    "fix:cs": "phpcbf --extensions=php --standard=PSR12 -n src tests tools",
    "fix:rector": "php vendor/bin/rector process src tests tools",
    "fix:wsdl-coverage": "php tools/wsdl-coverage.php --write",
    "fix:all": [
      "@fix:rector",
      "@fix:cs"
    ]
  },
  "archive": {
    "exclude": [
      "/tests"
    ]
  },
  "config": {
    "sort-packages": true
  }
}
